# nxm-tui — local development API keys
#
# Copy this file to `.env` (gitignored) and fill in your keys. When a `.env`
# file is present, nxm-tui runs in DEV key mode: it reads keys from the
# environment FIRST and never touches the OS keychain, so you get NO password
# prompt during development.
#
# Resolution in dev mode (keychain skipped):
#   1. provider-specific var (e.g. NVIDIA_API_KEY)
#   2. NEXUM_API_KEY
#   3. OPENAI_API_KEY
#
# To force a mode regardless of the .env file:
#   NXM_KEY_SOURCE=env       # always env-first, never touch keychain
#   NXM_KEY_SOURCE=keychain  # always keychain-first (production default)
#   NXM_KEY_SOURCE=auto      # env-first iff a .env is present (default)

# Provider-specific (matches Provider.api_key_env)
NVIDIA_API_KEY=

# Global fallbacks
NEXUM_API_KEY=
OPENAI_API_KEY=
